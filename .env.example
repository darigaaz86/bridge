# ── Frontend ──────────────────────────────────────────────
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Indexer UI (history page redirects here)
NEXT_PUBLIC_INDEXER_UI_URL=https://qore-bridge.qore3.com/indexer

# Aggregator contract address (same on all chains via CREATE2)
NEXT_PUBLIC_AGGREGATOR_ADDRESS=0x039dBEf1513016dD84DE9CE4fd98329631e58168

# ── Indexer ───────────────────────────────────────────────
POSTGRES_PASSWORD=changeme

# CHAINS is a JSON array of chain configs for the indexer.
# Each entry: chainId, rpcUrl, aggregatorAddress, startBlock
CHAINS='[{"chainId":11155111,"rpcUrl":"https://ethereum-sepolia-rpc.publicnode.com","aggregatorAddress":"0x039dBEf1513016dD84DE9CE4fd98329631e58168","startBlock":10467272}]'

POLL_INTERVAL=10
STATUS_POLL_INTERVAL=10
API_PORT=8080
